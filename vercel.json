{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api?odp_path=$1" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{packages/web/public/**,packages/passport-engine/fixtures/**,packages/matching-engine/fixtures/**,packages/domain/fixtures/**,packages/pilot/fixtures/**,packages/*/dist/**}"
    }
  }
}
