# ── Solana (P0 只跑 devnet) ─────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# ── Human Identity ─────────────────────────────────────
# P0 使用 fixture / mock X profile;真实 OAuth 是后续阶段的接口边界
# Early Humans V0 uses a stub X handle + explicit consent (x_oauth is reserved, not implemented)
ODP_HUMAN_SOURCE=fixture          # fixture | x_oauth
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
ODP_PILOT_DIR=                    # optional; default ${ODP_DATA_DIR}/pilot or .odp/pilot
# Vercel / serverless: writable dir (repo FS is read-only). Default on VERCEL=1 is /tmp/odp-pilot (ephemeral).
ODP_PILOT_DATA_DIR=

# ── App ────────────────────────────────────────────────
ODP_PORT=3000
ODP_DATA_DIR=./data               # P0 使用文件型存储,不引入数据库
