{
  "name": "@odp/passport-engine",
  "version": "0.1.0",
  "description": "ODP Project Passport Engine: discovery input, evidence assembly, passport generation/reassessment, validated persistence, read models",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "regen-golden": "tsx scripts/regen-golden.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@odp/domain": "*",
    "zod": "^4.0.0"
  }
}
